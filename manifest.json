{
  "manifest_version": 3,
  "name": "Night Better",
  "version": "1.5.0",
  "description": "Toolbar switch for your existing Firefox proxy, plus helpers for adjustable Nova corner radius, tighter tabs, a solid dark top bar, and hiding Share Firefox.",
  "author": "Joel",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "addon@firefox-better",
      "strict_min_version": "157.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["proxy", "storage", "clipboardWrite", "menus"],
  "incognito": "spanning",
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Night Better",
    "default_popup": "popup/popup.html",
    "default_area": "navbar",
    "default_icon": "icons/icon.svg",
    "theme_icons": [
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon-dark.svg",
        "size": 16
      },
      {
        "light": "icons/icon-light.svg",
        "dark": "icons/icon-dark.svg",
        "size": 32
      }
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
